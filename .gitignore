# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# deadline-brief runner state (which GW was last emailed)
scripts/.deadline-brief-state.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloned vaastav FPL dataset (external, large) — not part of the app
/historical_data

# Generated backtest artifacts (large)
research/composite-backtest/out/

# Fetched FPL data cache for squad-eval (28M of JSON — regenerate via fetch-cache.ts)
research/squad-eval/cache/

# Python + OS cruft
**/__pycache__/
**/.DS_Store

# Local-only Claude Code launch config
.claude/launch.json

# Demo video — too large to commit; upload via GitHub's web UI for an inline player
docs/images/*.mov

# live-eval tick state (per-step progress + failure counters) and the data-branch worktree
scripts/.live-eval-state.json
.worktrees/

# Live-eval artefacts rewritten by every tick (capture / score / dataset build). Their
# history lives on the `live-eval-data` branch, which the tick syncs and pushes; tracking
# them on code branches left the checkout permanently dirty and blocked checkout/pull.
# (Explicit names, not `live-*`, so research/squad-eval/live-types.ts stays tracked.)
research/squad-eval/live-status.md
research/squad-eval/live-log.json
research/squad-eval/live-report.md
research/squad-eval/live-transfer-report.md
research/squad-eval/live-dataset.csv
research/squad-eval/live-dataset.parquet
research/squad-eval/live-pool-dataset.csv
research/squad-eval/live-pool-dataset.parquet
research/squad-eval/pool/
