# Copy to .env.local and fill in. .env.local is gitignored — real values never commit.

# LLM features (Ask The Scout, syntheses). App runs without it — deterministic engine only.
ANTHROPIC_API_KEY=

# Deadline brief email (scripts/deadline-brief.ts — runs 5h before each GW deadline)
RESEND_API_KEY=
BRIEF_EMAIL_TO=
# FPL manager id the brief + live-eval capture run for (optional; harness default applies)
BRIEF_TEAM_ID=
